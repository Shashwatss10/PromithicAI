# ============================================================
# PromithicAI v2.0 - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.
# ============================================================

# -- LLM Providers (server-side fallback keys) ---------------
# Used when user has no BYOK key. Leave empty to disable.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
NVIDIA_API_KEY=nvapi-...

# -- Firebase ------------------------------------------------
# From Firebase Console > Project Settings > General
FIREBASE_PROJECT_ID=promithicai-a1

# -- Supabase ------------------------------------------------
# From Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xlzzxhpkyupjbqxuaksm.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# -- App -----------------------------------------------------
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://promithicai.vercel.app,http://localhost:5500,http://127.0.0.1:5500

# Port (Railway sets this automatically)
PORT=8000
